# ============================================================
# SellerDesk API Configuration (.env.example)
# Copy to .env and customize values for your deployment.
# ============================================================

# ── Application Environment ──────────────────────────────────
NODE_ENV=development
PORT=5001

# ── Security & Authentication ────────────────────────────────
# Secret used to sign JSON Web Tokens (HMAC-SHA256).
# IMPORTANT: Generate a strong random 64-character secret for production:
# openssl rand -base64 48
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# ── CORS Settings ─────────────────────────────────────────────
# Allowed frontend origins. Comma-separated or single URL.
CORS_ORIGIN=http://localhost:5173

# ── Database Configuration ────────────────────────────────────
# Supported DB_CLIENT options:
#   - sqlite (default, zero-config local development)
#   - mysql  (production MariaDB / MySQL 8.0+)
DB_CLIENT=sqlite

# SQLite Configuration (Used when DB_CLIENT=sqlite)
SQLITE_FILE=./database/sellerdesk.sqlite

# MySQL / MariaDB Configuration (Used when DB_CLIENT=mysql or via Railway MYSQLHOST)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sellerdesk
DB_PASSWORD=your_secure_db_password_here
DB_NAME=sellerdesk
# MYSQL_URL=mysql://sellerdesk:password@127.0.0.1:3306/sellerdesk

# ── Deployment & Initialization ──────────────────────────────
# Automatically seed multi-tenant demo merchants on initial deployment
AUTO_SEED=false
# LOGIN_RATE_LIMIT=120
